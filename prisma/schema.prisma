generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float
  description String?
  imageUrl    String?
  
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  
  orders      Order[]  // এই প্রোডাক্টের সব অর্ডার জমা থাকবে
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// নতুন: কাস্টমারের অর্ডারের তথ্য সেভ রাখার জন্য
model Order {
  id             String   @id @default(cuid())
  customerName   String
  phone          String
  address        String
  deliveryArea   String   // ঢাকার ভেতরে নাকি বাইরে
  deliveryFee    Float    // ৮০ নাকি ১৩০ টাকা
  totalPrice     Float    // প্রোডাক্টের দাম + ডেলিভারি চার্জ
  status         String   @default("PENDING") // Pending, Confirmed, Delivered ইত্যাদি
  
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}